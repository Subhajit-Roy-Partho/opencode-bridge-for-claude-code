{
  "name": "opencode-bridge-for-claude-code",
  "version": "0.3.0",
  "description": "MCP bridge that lets Claude Code delegate easy/medium work to opencode agents, enforces the routing modes, and shows every opencode session and its output.",
  "type": "module",
  "main": "server.mjs",
  "bin": { "opencode-bridge": "server.mjs" },
  "license": "MIT",
  "author": "Subhajit-Roy-Partho",
  "repository": { "type": "git", "url": "git+https://github.com/Subhajit-Roy-Partho/opencode-bridge-for-claude-code.git" },
  "homepage": "https://github.com/Subhajit-Roy-Partho/opencode-bridge-for-claude-code#readme",
  "keywords": ["claude-code", "opencode", "mcp", "model-context-protocol", "delegation", "agents", "subagents"],
  "engines": { "node": ">=18" },
  "scripts": {
    "test": "node --test test/bridge.test.mjs test/policy.test.mjs",
    "test:live": "OPENCODE_BRIDGE_LIVE=1 node --test test/live.test.mjs",
    "start": "node server.mjs"
  },
  "files": ["server.mjs", "README.md", "LICENSE", "docs", "examples"]
}
